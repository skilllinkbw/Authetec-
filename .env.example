# Authetec — environment template (copy to .env and fill in real values)
# NEVER commit .env or real secrets.

AUTHETEC_ENV=development
AUTHETEC_DEBUG=false

# Security (REQUIRED in production)
AUTHETEC_JWT_SECRET=change-me-to-a-long-random-string
AUTHETEC_JWT_ALGORITHM=HS256
AUTHETEC_JWT_EXPIRY_MINUTES=120
# SHA-256 fingerprint of the accepted X-API-Key (raw key is never stored)
AUTHETEC_API_KEY_SHA256=
AUTHETEC_CORS_ORIGINS=http://localhost:3000

# Supabase (server-side only — the service key must NEVER reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Vector store backend: memory | chroma | qdrant
AUTHETEC_VECTOR_BACKEND=memory

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Risk policy
AUTHETEC_RISK_CLEAR=0.30
AUTHETEC_RISK_REVIEW=0.70
AUTHETEC_RATE_LIMIT_PER_MIN=120

# Uploads / retention
AUTHETEC_MAX_UPLOAD_MB=20
AUTHETEC_BIOMETRIC_RETENTION_DAYS=90
