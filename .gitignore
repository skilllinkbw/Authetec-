# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Environment / secrets
.env
.env.local

# Node / frontend build artifacts
node_modules/
frontend/dist/
frontend/coverage/

# Third-party reference repositories cloned for benchmark comparison.
# These are external projects (some with their own .git) and are NOT part
# of the Authetec implementation. Only Authetec's own benchmark adapters,
# runner and generated reports under benchmarks/ are tracked.
benchmarks/repo1_lightgbm/
benchmarks/repo2_ensemble/
benchmarks/repo3_pipeline/
benchmarks/repo4_insurance/
benchmarks/repo5_graph/
benchmarks/repo6_identity/

# ─────────────────────────────────────────────────────────────────────
# Biometric data protections
# ─────────────────────────────────────────────────────────────────────
# Raw biometric samples must NEVER be committed.  Only manifests with
# light-weight metadata and generated reports may appear in Git, and
# manifests must not embed image data.
benchmarks/biometric/data/
datasets/
datasets_biometric/

# Raw-biometric extension guard: unknown image files anywhere (including
# repo root) are refused by default.  Already-tracked project images stay
# tracked; explicit negations allow new assets in the public asset dirs.
*.jpeg
*.jpg
*.png
*.tif
*.tiff
*.bmp
*.webp
!assets/*.png
!frontend/public/**/*.png
!frontend/public/**/*.jpg
!assets/*.jpg
